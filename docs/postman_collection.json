{
  "info": {
    "name": "Fuel Route API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{"key": "baseUrl", "value": "http://127.0.0.1:8000"}],
  "item": [
    {"name": "Dallas-Chicago", "request": {"method": "GET", "url": "{{baseUrl}}/api/route/?start=Dallas%2C%20TX&finish=Chicago%2C%20IL"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('status',()=>pm.response.code===200);", "pm.test('summary',()=>!!pm.response.json().summary);", "pm.test('external calls <= 3',()=>pm.response.json().meta.external_calls<=3);"]}}]},
    {"name": "New York-Miami", "request": {"method": "GET", "url": "{{baseUrl}}/api/route/?start=New%20York%2C%20NY&finish=Miami%2C%20FL"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('status',()=>pm.response.code===200);", "pm.test('summary',()=>!!pm.response.json().summary);", "pm.test('external calls <= 3',()=>pm.response.json().meta.external_calls<=3);"]}}]},
    {"name": "Los Angeles-New York", "request": {"method": "GET", "url": "{{baseUrl}}/api/route/?start=Los%20Angeles%2C%20CA&finish=New%20York%2C%20NY"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('status',()=>pm.response.code===200);", "pm.test('summary',()=>!!pm.response.json().summary);", "pm.test('external calls <= 3',()=>pm.response.json().meta.external_calls<=3);"]}}]},
    {"name": "Seattle-Miami", "request": {"method": "GET", "url": "{{baseUrl}}/api/route/?start=Seattle%2C%20WA&finish=Miami%2C%20FL"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('status',()=>pm.response.code===200);", "pm.test('summary',()=>!!pm.response.json().summary);", "pm.test('external calls <= 3',()=>pm.response.json().meta.external_calls<=3);"]}}]},
    {"name": "LA-Seattle gap", "request": {"method": "GET", "url": "{{baseUrl}}/api/route/?start=Los%20Angeles%2C%20CA&finish=Seattle%2C%20WA"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('status',()=>pm.response.code===422);", "pm.test('error',()=>!!pm.response.json().error);", "pm.test('external calls <= 3',()=>pm.response.json().meta.external_calls<=3);"]}}]},
    {"name": "LA-Seattle range 1000", "request": {"method": "GET", "url": "{{baseUrl}}/api/route/?start=Los%20Angeles%2C%20CA&finish=Seattle%2C%20WA&range_miles=1000"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('status',()=>pm.response.code===200);", "pm.test('summary',()=>!!pm.response.json().summary);", "pm.test('external calls <= 3',()=>pm.response.json().meta.external_calls<=3);"]}}]},
    {"name": "Missing params", "request": {"method": "GET", "url": "{{baseUrl}}/api/route/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('status',()=>pm.response.code===400);", "pm.test('error',()=>!!pm.response.json().error);"]}}]},
    {"name": "Toronto", "request": {"method": "GET", "url": "{{baseUrl}}/api/route/?start=Toronto%2C%20ON&finish=Chicago%2C%20IL"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('status',()=>pm.response.code===400);", "pm.test('error',()=>pm.response.json().error.code==='LOCATION_NOT_IN_US');"]}}]},
    {"name": "POST example", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"start\":\"Dallas, TX\",\"finish\":\"Chicago, IL\"}"}, "url": "{{baseUrl}}/api/route/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('status',()=>pm.response.code===200);", "pm.test('summary',()=>!!pm.response.json().summary);", "pm.test('external calls <= 3',()=>pm.response.json().meta.external_calls<=3);"]}}]}
  ]
}
